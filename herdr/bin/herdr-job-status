#!/usr/bin/env bash
# One line for the Herdr tab bar: whether a background job is running or still writing its output,
# so you know before reading files it is in the middle of rewriting. Prints nothing until
# ~/.config/job-status.conf exists. That file is shell syntax:
#   LABEL="ETL"                  # the name shown in the bar
#   PROCESS="etl.py"             # a pgrep -f pattern
#   DIR="$HOME/path/to/output"   # where the job writes
#   PATTERN="*.parquet"          # optional, default: every file
#   MINUTES=15                   # optional, default: 15
conf="${JOB_STATUS_CONF:-$HOME/.config/job-status.conf}"
[ -r "$conf" ] || exit 0

LABEL=Job PROCESS='' DIR='' PATTERN='*' MINUTES=15
# shellcheck source=/dev/null
. "$conf"

if [ -n "$PROCESS" ] && pgrep -f "$PROCESS" >/dev/null; then
  echo "⚠ $LABEL running"
elif [ -n "$DIR" ] && [ -n "$(find "$DIR" -type f -name "$PATTERN" -mmin -"$MINUTES" 2>/dev/null | head -1)" ]; then
  echo "⚠ $LABEL wrote <$MINUTES min ago"
else
  echo "$LABEL idle"
fi
