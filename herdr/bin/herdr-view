#!/usr/bin/env bash
# Opens a file or directory in the program for its kind, or with --kind only names that kind.
#   herdr-view [--kind] <path>
set -euo pipefail

usage() { echo "Usage: herdr-view [--kind] <path>" >&2; exit 2; }

# Rendered by glow into less rather than read in glow's own viewer, where the left arrow means
# "back to the file list" and a wide table scrolled right can't be scrolled back.
view_markdown() {
  local keys status
  keys="$(mktemp)"
  trap 'rm -f "$keys"' EXIT
  # "quit X" makes less exit with X's character code as its status.
  printf '#command\ne quit e\nr quit r\n' > "$keys"
  while true; do
    status=0
    glow -s dark -w $(( $(tput cols) - 2 )) "$1" | LESS='' less -RS --lesskey-src="$keys" || status=$?
    case "$status" in
      101) code --wait "$1" ;;
      114) ;;
      *) return 0 ;;
    esac
  done
}

kind_of() {
  if [ -d "$1" ]; then
    echo editor
    return
  fi
  case "$(printf '%s' "${1##*.}" | tr '[:upper:]' '[:lower:]')" in
    md|markdown) echo markdown ;;
    pdf) echo pdf ;;
    csv|tsv|parquet|xlsx|json|jsonl) echo table ;;
    *) echo editor ;;
  esac
}

if [ "${1:-}" = --kind ]; then
  [ $# -eq 2 ] || usage
  kind_of "$2"
  exit 0
fi
[ $# -eq 1 ] || usage
path="$1"

case "$(kind_of "$path")" in
  markdown) view_markdown "$path" ;;
  pdf) exec tdf "$path" ;;
  # Multithreaded pyarrow can segfault on some parquet files.
  table) OMP_NUM_THREADS=1 ARROW_NUM_THREADS=1 exec vd "$path" ;;
  editor) exec code "$path" ;;
esac
