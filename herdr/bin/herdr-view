#!/usr/bin/env bash
# Opens a file or directory in the terminal program for its kind.
#   herdr-view <path>
set -euo pipefail

[ $# -eq 1 ] || { echo "Usage: herdr-view <path>" >&2; exit 2; }
path="$1"

# Rendered by glow into less rather than read in glow's own viewer, where the left arrow means
# "back to the file list" and a wide table scrolled right can't be scrolled back.
view_markdown() {
  local keys status
  keys="$(mktemp)"
  trap 'rm -f "$keys"' EXIT
  # "quit X" makes less exit with X's character code as its status.
  printf '#command\ne quit e\nr quit r\n' > "$keys"
  while true; do
    status=0
    glow -s dark -w $(( $(tput cols) - 2 )) "$1" | LESS='' less -RS --lesskey-src="$keys" || status=$?
    case "$status" in
      101) micro "$1" ;;
      114) ;;
      *) return 0 ;;
    esac
  done
}

[ -d "$path" ] && exec yazi "$path"

extension="$(printf '%s' "${path##*.}" | tr '[:upper:]' '[:lower:]')"
case "$extension" in
  md|markdown) view_markdown "$path" ;;
  pdf) exec tdf "$path" ;;
  # Multithreaded pyarrow can segfault on some parquet files.
  csv|tsv|parquet|xlsx|json|jsonl) OMP_NUM_THREADS=1 ARROW_NUM_THREADS=1 exec vd "$path" ;;
  *) exec micro "$path" ;;
esac
