{
    "editor.minimap.enabled": false,
    "editor.tabSize": 2,
    "editor.rulers": [72, 79],
    "editor.renderWhitespace": "all",
    "files.autoSave": "onWindowChange",
    "diffEditor.ignoreTrimWhitespace": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "workbench.colorTheme": "Adey Coder - Deep Dark",
    "update.showReleaseNotes": false,

    "git.confirmSync": false,
    "githubPullRequests.pullBranch": "never",
    "gitlens.views.scm.grouped.views": {
        "commits": true,
        "branches": true,
        "remotes": true,
        "stashes": true,
        "tags": true,
        "worktrees": true,
        "contributors": true,
        "repositories": false,
        "searchAndCompare": true,
        "launchpad": false
    },
    "gitlens.views.commitDetails.files.layout": "tree",

    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false,
        "python": true
    },
    "github.copilot.preferredAccount": "fedemelo",
    "continue.enableTabAutocomplete": false,
    "claudeCode.preferredLocation": "panel",

    "cSpell.language": "en,es-ES",
    "cSpell.userWords": [
        "almacernarse",
        "biyectiva",
        "biyectivo",
        "docstrings",
        "estudiantado",
        "fundings",
        "homomorfismo",
        "homomorfismos",
        "idempotente",
        "interesantemente",
        "monoide",
        "pregrado",
        "semigrupo",
        "Shamos",
        "vicedecantura"
    ],

    "typescript.updateImportsOnFileMove.enabled": "always",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "svelte.enable-ts-plugin": true,
    "autoDocstring.docstringFormat": "numpy",
    "rust-analyzer.checkOnSave": true,
    "rust-analyzer.check.command": "clippy",
    "haskell.manageHLS": "PATH",
    "jdk.telemetry.enabled": false,

    "[python]": {
        "editor.formatOnSaveMode": "file",
        "editor.formatOnSave": false,
        "editor.defaultFormatter": "eeyore.yapf",
        "editor.formatOnType": false
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },
    "[java]": {
        "editor.defaultFormatter": "Oracle.oracle-java"
    },
    "[latex]": {
        "editor.defaultFormatter": "mathematic.vscode-latex"
    },
    "workbench.editorAssociations": {
        "*.pdf": "latex-workshop-pdf-hook"
    }
}
